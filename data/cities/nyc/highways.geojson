      "properties": {
        "name": "FDR Drive (East River Drive)",
        "designation": "FDR Drive",
        "construction_year": 1934,
        "completion_year": 1966,
        "decade": "1930s",
        "neighborhoods_displaced": [
          "Lower East Side",
          "East Harlem"
        ],
        "description": "Built along Manhattan's East River waterfront, the FDR Drive cut off neighborhoods from river access. In the Lower East Side and East Harlem, it created a wall of traffic between dense immigrant communities and the waterfront, contributing to environmental injustice and reduced quality of life."
      }
