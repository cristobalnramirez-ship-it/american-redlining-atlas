      "properties": {
        "name": "Bruckner Expressway",
        "designation": "I-278 East",
        "construction_year": 1956,
        "completion_year": 1972,
        "decade": "1960s",
        "neighborhoods_displaced": [
          "Hunts Point",
          "Longwood",
          "Soundview"
        ],
        "description": "Built through the already struggling South Bronx, the Bruckner Expressway further isolated Hunts Point and Longwood from the rest of the borough. The highway facilitated the concentration of noxious industrial uses \u2014 including the Hunts Point Food Distribution Center \u2014 in communities already burdened by poverty and pollution."
      }
