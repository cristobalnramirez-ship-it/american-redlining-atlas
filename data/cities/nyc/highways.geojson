      "properties": {
        "name": "Major Deegan Expressway",
        "designation": "I-87",
        "construction_year": 1939,
        "completion_year": 1956,
        "decade": "1940s",
        "neighborhoods_displaced": [
          "Port Morris",
          "Mott Haven",
          "Highbridge"
        ],
        "description": "Running along the Harlem River through the South Bronx, the Major Deegan severed waterfront communities from river access. Combined with the Cross-Bronx Expressway, it helped create the infrastructure cage around the South Bronx that contributed to the borough's decline."
      }
