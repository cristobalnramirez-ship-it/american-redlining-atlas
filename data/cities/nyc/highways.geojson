      "properties": {
        "name": "Cross-Bronx Expressway",
        "designation": "I-95",
        "construction_year": 1948,
        "completion_year": 1963,
        "decade": "1950s",
        "neighborhoods_displaced": [
          "East Tremont",
          "Morris Heights",
          "Highbridge",
          "Crotona Park East"
        ],
        "description": "The most notorious highway in American urban history. Robert Moses routed it directly through the dense, working-class neighborhood of East Tremont, displacing over 60,000 residents and destroying 159 buildings. Residents begged for an alternate route through Crotona Park \u2014 Moses refused. The expressway severed the South Bronx from the rest of the borough, accelerating a spiral of disinvestment, abandonment, and arson that culminated in the 'Bronx is Burning' era of the 1970s."
      }
    },
