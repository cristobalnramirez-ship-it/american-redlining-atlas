      "properties": {
        "name": "Brooklyn-Queens Expressway",
        "designation": "I-278",
        "construction_year": 1939,
        "completion_year": 1964,
        "decade": "1940s",
        "neighborhoods_displaced": [
          "Brooklyn Heights",
          "Red Hook",
          "Sunset Park",
          "Williamsburg",
          "Greenpoint"
        ],
        "description": "Robert Moses's first major highway in NYC, the BQE carved through waterfront neighborhoods across Brooklyn. In Brooklyn Heights, it was controversially built as a triple-cantilevered structure along the bluff. The highway severed Red Hook from the rest of Brooklyn, contributing to decades of isolation and poverty in what had been a thriving dockworker community."
      }
    },
