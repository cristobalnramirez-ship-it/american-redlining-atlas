      "properties": {
        "name": "Gowanus Expressway",
        "designation": "I-278 South",
        "construction_year": 1941,
        "completion_year": 1964,
        "decade": "1940s",
        "neighborhoods_displaced": [
          "Sunset Park",
          "Bay Ridge",
          "Gowanus"
        ],
        "description": "The elevated Gowanus Expressway cast a permanent shadow over Third Avenue in Sunset Park, destroying the commercial vitality of what had been Brooklyn's busiest shopping street. The highway's construction, combined with the loss of waterfront industrial jobs, devastated the working-class Norwegian, Italian, and Puerto Rican communities below."
      }
