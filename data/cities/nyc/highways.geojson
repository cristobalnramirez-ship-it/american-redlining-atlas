      "properties": {
        "name": "Sheridan Expressway",
        "designation": "I-895",
        "construction_year": 1958,
        "completion_year": 1963,
        "decade": "1960s",
        "neighborhoods_displaced": [
          "Crotona Park East",
          "West Farms",
          "Hunts Point"
        ],
        "description": "A 1.25-mile stub highway that destroyed homes and parkland but never connected to anything useful. The Sheridan became a symbol of Moses-era highway overreach. After decades of community activism, it was finally decommissioned and converted to a boulevard in 2019."
      }
